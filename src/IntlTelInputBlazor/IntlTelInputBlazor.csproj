<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <AssemblyVersion>3.0.6</AssemblyVersion>
        <FileVersion>3.0.6</FileVersion>
        <Authors>Rolandas, Giovanni Quarella, JeremyVm</Authors>
		<PackageId>IntlTelInput.MudBlazor</PackageId>
        <PackageTags>Blazor;intl-tel-input;MudBlazor</PackageTags>
        <Description>
	        International Telephone Input js library wrapper for Blazor serverside and clientside!
	        Includes a MudBlazor component as well.
        </Description>
        <Version>3.0.6</Version>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/JeremyVm/intl-tel-input-blazor</RepositoryUrl>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

	<PropertyGroup>
        <StaticWebAssetBasePath>_content/IntlTelInputBlazor</StaticWebAssetBasePath>
        <Title>International Telephone Input Blazor Component</Title>
        <PackageProjectUrl>https://github.com/JeremyVm/intl-tel-input-blazor</PackageProjectUrl>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <PackageReleaseNotes>
			v3.0.6: FixedSMudIntlTelInputet Text in OnTextAsync.
			See full changelog: https://github.com/JeremyVm/intl-tel-input-blazor/blob/main/CHANGELOG.md
		</PackageReleaseNotes>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.23" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.12" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.2" />
    </ItemGroup>

    <ItemGroup>
		<PackageReference Include="MudBlazor" Version="8.15.0" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="wwwroot\background.png" />
      <_ContentIncludedByDefault Remove="wwwroot\exampleJsInterop.js" />
    </ItemGroup>

    <ItemGroup>
      <None Include="readme.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- npm build target to copy intl-tel-input assets -->
    <Target Name="NpmBuild" BeforeTargets="BeforeBuild" Condition="!Exists('wwwroot\js\intlTelInput.js')">
        <Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)" />
        <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
    </Target>

</Project>
