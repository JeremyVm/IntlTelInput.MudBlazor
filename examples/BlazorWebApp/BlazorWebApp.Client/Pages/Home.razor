@page "/"

<PageTitle>Home</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Phone Number Entry</MudText>

<EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

    <MudGrid>
        <MudItem xs="12" sm="3" Class="d-flex align-center">
            <MudText>Primary Phone</MudText>
        </MudItem>
        <MudItem xs="12" sm="9">
            <MudIntlTelInput @bind-Value="_model.IntTelNumber"
                             Placeholder="Enter your phone number"
                             InitialCountry="auto"
                             Immediate="true"
                             For="@(() => _model.IntTelNumber)" />
        </MudItem>

        <MudItem xs="12" sm="3" Class="d-flex align-center">
            <MudText>Secondary Phone</MudText>
        </MudItem>
        <MudItem xs="12" sm="9">
            <MudIntlTelInput @bind-Value="_model.IntTelNumber2"
                             Placeholder="Enter your phone number"
                             InitialCountry="auto"
                             Immediate="true"
                             For="@(() => _model.IntTelNumber2)" />
        </MudItem>

        <MudItem xs="12" Class="d-flex justify-end mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Save</MudButton>
        </MudItem>

        @if (_submitted)
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Success" Class="mt-4">
                    Saved! Number 1: @_model.IntTelNumber?.Number | Number 2: @_model.IntTelNumber2?.Number
                </MudAlert>
            </MudItem>
        }
    </MudGrid>
</EditForm>

@code
{
    NumberModel _model = new NumberModel();
    EditContext _editContext;
    bool _submitted;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
    }

    private void OnValidSubmit()
    {
        _submitted = true;
        Console.WriteLine($"Number 1: {_model.IntTelNumber?.Number}; Number 2: {_model.IntTelNumber2?.Number}");
    }
}